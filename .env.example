# quran-api-unified needs NO environment variables to run — the core is keyless and works
# out of the box with the open providers. The variables below are OPTIONAL and used only by
# the live-smoke test suite (`pnpm test:live`) for providers that require credentials.
# Copy this file to `.env` and fill in the ones you want the live suite to exercise.

# Quran Foundation (Quran.com v4) — OAuth2 client credentials.
# Register an app at https://api-docs.quran.foundation to obtain these.
QURAN_FOUNDATION_CLIENT_ID=
QURAN_FOUNDATION_CLIENT_SECRET=
